{
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": { "@usevibejs/dnd": ["./src/index.ts"] }
  },
  "contentMappers": [{ "package": "@usevibejs/language-tools", "extensions": [".vibe"] }],
  "include": ["examples", "src", "test/fixtures"],
  "exclude": ["examples/integrations"]
}
